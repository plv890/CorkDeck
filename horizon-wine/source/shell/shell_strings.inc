static const char *shell_translate( const char *text )
{
    static unsigned short slots[1024];
    static int built;
    unsigned int hash = 2166136261u, i, n = sizeof(shell_russian) / sizeof(shell_russian[0]);
    const unsigned char *c;

    if (shell_language != APP_LANG_RU || !text || !text[0]) return text;
    if (!built)
    {
        for (i = 0; i < n; i++)
        {
            unsigned int h = 2166136261u;

            for (c = (const unsigned char *)shell_russian[i][0]; *c; c++) h = (h ^ *c) * 16777619u;
            for (h &= 1023; slots[h]; h = (h + 1) & 1023) {}
            slots[h] = (unsigned short)(i + 1);
        }
        built = 1;
    }
    for (c = (const unsigned char *)text; *c; c++) hash = (hash ^ *c) * 16777619u;
    for (hash &= 1023; slots[hash]; hash = (hash + 1) & 1023)
        if (!strcmp( shell_russian[slots[hash] - 1][0], text )) return shell_russian[slots[hash] - 1][1];
    return text;
}
